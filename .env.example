# Copy to .env and fill in your real values.
# Create a bot with @BotFather, then get your user id from @userinfobot
# (or via https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot).

TELEGRAM_BOT_TOKEN=123456:ABC-YOUR-TOKEN-HERE
ALLOWED_USER_IDS=11111111,22222222

# Groq API key for voice transcription (free at https://console.groq.com/keys).
# Only needed if config.yaml has stt.provider: groq
GROQ_API_KEY=
